# Frontend Vite server / preview listen port
PORT=6101

# Backend API base URL used by the browser.
# Use "/api" when Vite proxies to the backend (Docker / local default).
# Or a full URL, e.g. http://localhost:6102/api
VITE_API_URL=/api

# Public frontend URL(s). Hostnames are used for Vite allowedHosts.
# Comma-separated for multiple domains (local + hosted).
FRONTEND_URL=http://localhost:6101,https://ai-interview.myselfproject.org,https://ai_interview.myselfproject.org

# Vite /api proxy target (server-side only; Docker overrides this)
API_PROXY_TARGET=http://localhost:6102
